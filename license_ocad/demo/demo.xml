<odoo>
    <record id="license.license_product0" model="product.product">
        <field name="name">OCAD 2018</field>
    </record>

    <!-- Version 12 -->
    <record
        id="product_information_attribute_ocad9"
        model="product.information.attribute"
    >
        <field name="key_id" ref="product_information_key_ocad0" />
        <field name="attribute_type">integer</field>
        <field name="value_id" ref="product_information_value_ocad7" />
    </record>

    <!-- Software License -->
    <record id="license.license_product0" model="product.product">
        <field
            name="attribute_ids"
            eval="[
        (4, ref('product_information_attribute_ocad0')),
        (4, ref('product_information_attribute_ocad1')),
        (4, ref('product_information_attribute_ocad2')),
        (4, ref('product_information_attribute_ocad3')),
        (4, ref('product_information_attribute_ocad4')),
        (4, ref('product_information_attribute_ocad5')),
        (4, ref('product_information_attribute_ocad6')),
      ]"
        />
    </record>

    <!-- Software License (Team) -->
    <record id="license.license_product1" model="product.product">
        <field
            name="attribute_ids"
            eval="[
        (4, ref('product_information_attribute_ocad0')),
        (4, ref('product_information_attribute_ocad1')),
        (4, ref('product_information_attribute_ocad2')),
        (4, ref('product_information_attribute_ocad3')),
        (4, ref('product_information_attribute_ocad4')),
        (4, ref('product_information_attribute_ocad7')),
        (4, ref('product_information_attribute_ocad8'))
      ]"
        />
    </record>

    <!-- Software License 12 -->
    <record id="license_product2" model="product.product">
        <field name="name">Software License 12</field>
        <field name="type">service</field>
        <field
            name="attribute_ids"
            eval="[
        (4, ref('product_information_attribute_ocad9')),
        (4, ref('product_information_attribute_ocad1')),
        (4, ref('product_information_attribute_ocad2')),
        (4, ref('product_information_attribute_ocad3')),
        (4, ref('product_information_attribute_ocad4')),
        (4, ref('product_information_attribute_ocad5')),
        (4, ref('product_information_attribute_ocad6')),
      ]"
        />
    </record>

    <record id="license.seq_license_license" model="ir.sequence">
        <field name="number_next_actual">60000</field>
        <field name="prefix" />
        <field name="padding">5</field>
    </record>

    <record id="license.license0" model="license.license">
        <field name="name">60000</field>
    </record>

    <record id="license.license1" model="license.license">
        <field name="name">60001</field>
    </record>

    <!-- OCAD 2018 -->
    <record id="license2" model="license.license">
        <field name="name">5002</field>
        <field name="product_id" ref="license.license_product0" />
        <field name="client_order_ref">OCAD AG</field>
        <field name="type_id" ref="license.type0" />
        <field name="partner_id" ref="base.res_partner_address_31" />
        <field name="registered" eval="True" />
    </record>

    <!-- OCAD 12 -->
    <record id="license3" model="license.license">
        <field name="name">5002</field>
        <field name="product_id" ref="license_product2" />
        <field name="client_order_ref">OCAD AG</field>
        <field name="type_id" ref="license.type0" />
        <field name="partner_id" ref="base.res_partner_address_31" />
        <field name="registered" eval="True" />
    </record>
</odoo>
